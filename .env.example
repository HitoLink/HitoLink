# サイトの公開 URL（metadataBase / canonical / robots / sitemap / JSON-LD で使用）
# 本番は Vercel の環境変数で独自ドメインを設定する。
# 未設定時は Vercel の本番ドメイン（VERCEL_PROJECT_PRODUCTION_URL）→ localhost の順で決まる。
NEXT_PUBLIC_SITE_URL=

# Google Search Console の HTML タグ確認に使う content 値（DNS TXT で確認するなら空のまま）
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
